{
  "name": "achmage-bases-look",
  "version": "1.2.0",
  "description": "Obsidian plugin: thumbnails and group colors for core Bases views.",
  "repository": "github:laguna821/achmage-bases-look",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "keywords": [
    "obsidian",
    "bases",
    "thumbnail",
    "kanban"
  ],
  "author": "Achmage",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
